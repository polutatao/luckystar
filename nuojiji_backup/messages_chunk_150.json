[{"id":1778551801624,"text":"“看到了吗？”他问。","rawContent":"“看到了吗？”他问。","isHtml":false,"sticker":null,"sender":"them","time":"10:25","timestamp":1778552746323,"roundId":"round_1778551818210_9djmtt76q","generatedMode":false,"translation":null,"userId":"uid_1775896106705_evl3e13jn","characterId":"e005ad20-6483-4398-97f5-8088200867c3","_id":7919},{"id":1778551801625,"text":"你点了点头。","rawContent":"你点了点头。","isHtml":false,"sticker":null,"sender":"them","time":"10:25","timestamp":1778552748512,"roundId":"round_1778551818210_9djmtt76q","generatedMode":false,"translation":null,"userId":"uid_1775896106705_evl3e13jn","characterId":"e005ad20-6483-4398-97f5-8088200867c3","_id":7920},{"id":1778551801626,"text":"“你现在这个样子，是谁弄的？”","rawContent":"“你现在这个样子，是谁弄的？”","isHtml":false,"sticker":null,"sender":"them","time":"10:25","timestamp":1778552751723,"roundId":"round_1778551818210_9djmtt76q","generatedMode":false,"translation":null,"userId":"uid_1775896106705_evl3e13jn","characterId":"e005ad20-6483-4398-97f5-8088200867c3","_id":7921},{"id":1778551801627,"text":"“……是你。”","rawContent":"“……是你。”","isHtml":false,"sticker":null,"sender":"them","time":"10:25","timestamp":1778552754332,"roundId":"round_1778551818210_9djmtt76q","generatedMode":false,"translation":null,"userId":"uid_1775896106705_evl3e13jn","characterId":"e005ad20-6483-4398-97f5-8088200867c3","_id":7922},{"id":1778551801628,"text":"“你身上这些痕迹，是谁留下的？”","rawContent":"“你身上这些痕迹，是谁留下的？”","isHtml":false,"sticker":null,"sender":"them","time":"10:25","timestamp":1778552757573,"roundId":"round_1778551818210_9djmtt76q","generatedMode":false,"translation":null,"userId":"uid_1775896106705_evl3e13jn","characterId":"e005ad20-6483-4398-97f5-8088200867c3","_id":7923},{"id":1778551801629,"text":"“……是你。”","rawContent":"“……是你。”","isHtml":false,"sticker":null,"sender":"them","time":"10:26","timestamp":1778552760181,"roundId":"round_1778551818210_9djmtt76q","generatedMode":false,"translation":null,"userId":"uid_1775896106705_evl3e13jn","characterId":"e005ad2