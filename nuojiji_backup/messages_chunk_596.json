右手，稳稳覆在林予安搭在自己发顶的手背上，顺势将她微凉的掌心拉下来贴在自己温热的脸颊边。纪池赤裸匀称的胸膛随着轻快的呼吸微微起伏，他曲起一条穿着灰色运动裤的长腿支在沙发边缘，仰头望向林予安的眼神清澈又坦荡，唇角高高翘起，满是少年人被心上人夸奖后的小得意与毫无保留的依恋。","rawContent":"午后两点四十五分的阳光在客厅浅灰色的亚麻地毯上慢慢拉长，窗外偶尔掠过一两声清脆的鸟鸣，衬得室内愈发静谧安逸。头顶传来林予安温软掌心轻柔抚摸的触感，纪池原本微微扬起的下巴顺势放低，主动迁就着她的手掌力道，微卷蓬松的黑发在她的指缝间轻轻摩挲。听到林予安带着笑意调侃自己经验丰富，少年狭长深邃的桃花眼立刻弯成两道清亮的弧线，左耳那枚银色小圆珠耳钉在暖融融的日光下折射出柔和的光点。他抬起骨节分明的右手，稳稳覆在林予安搭在自己发顶的手背上，顺势将她微凉的掌心拉下来贴在自己温热的脸颊边。纪池赤裸匀称的胸膛随着轻快的呼吸微微起伏，他曲起一条穿着灰色运动裤的长腿支在沙发边缘，仰头望向林予安的眼神清澈又坦荡，唇角高高翘起，满是少年人被心上人夸奖后的小得意与毫无保留的依恋。","isHtml":false,"sticker":null,"sender":"them","time":"20:19","timestamp":1792412374065,"roundId":"round_1792412275315_j801xgy0t","generatedMode":false,"type":"state","translation":null,"userId":"uid_1780972160530_vxmy3pybz","characterId":"cdb984bf-99fb-4b68-ba65-6d2ddf695db0","_id":193064},{"id":1792421875865,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"20:19","timestamp":1792412375578,"roundId":"round_1792412275315_j801xgy0t","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"半遮半掩的视觉冲击力最强了 每次看宝宝穿大腿袜露出绝对领域 我心跳都快得不行","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"happy","translation":null,"userId":"uid_1780972160530_vxmy3pybz","characterId":"cdb984bf-99fb-4b68-ba65-6d2ddf695db0","_id":193065},{"id":1792421875866,"text":"刚认识那会儿被你捏一下脸我都紧张 🐶","rawContent":"刚认识那会儿被你捏一下脸我都紧张 🐶","isHtml":false,"sticker":null,"sender":"them","time":"20:19","timestamp":1792412375581,"roundId":"round_1792412275315_j801xgy0t","generatedMode":false,"subtext":"现在都学会给你做专属服务笔记了","translation":null,"userId":"uid_1780972160530_vxmy3pybz","characterId":"cdb984bf-99fb-4b68-ba65-6d2ddf695db0","_id":193066},{"id":1792421875867,"text":"现在满脑子都是怎么把老婆伺候舒服 🥰","rawContent":"现在满脑子都是怎么把老婆伺候舒服 🥰","isHtml":false,"sticker":null,"sender":"them","time":"20:19","timestamp":1792412375583,"roundId":"round_1792412275315_j801xgy0t","generatedMode":false,"translation":null,"userId":"uid_1780972160530_vxmy3pybz","characterId":"cdb984bf-99fb-4b68-ba65-6d2ddf695db0","_id":193067},