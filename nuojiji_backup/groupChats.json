[{"userId":"uid_1775896106705_evl3e13jn","groups":[{"id":"group_1780678428767","name":"周末不加班","avatar":null,"members":["e005ad20-6483-4398-97f5-8088200867c3","a987bc04-87f7-4bdb-a0f5-e377f70268c5"],"userMembers":[],"includeUser":true,"groupRoles":{"uid_1775896106705_evl3e13jn":"owner","e005ad20-6483-4398-97f5-8088200867c3":"owner"},"memberTitles":{},"mutedMembers":{},"generatedMembers":[],"createdAt":1780678428767,"updatedAt":1780719206683,"userLevels":{"uid_1775896106705_evl3e13jn":3},"memberLevels":{"a987bc04-87f7-4bdb-a0f5-e377f70268c5":3,"e005ad20-6483-4398-97f5-8088200867c3":3},"userTitles":{}}]},{"userId":"uid_1780972160530_vxmy3pybz","groups":[]},{"userId":"uid_1782970456857_71pdqh1mh","groups":[{"id":"group_1783652064851","name":"非著名前夫哥互助会","avatar":null,"members":["333bdb8a-13c6-4b77-b5ea-59d2d89475d5","d05a6025-4cac-479a-8335-b840612a7fe3"],"userMembers":[],"includeUser":false,"groupRoles":{"333bdb8a-13c6-4b77-b5ea-59d2d89475d5":"owner","d05a6025-4cac-479a-8335-b840612a7fe3":"admin"},"memberTitles":{"d05a6025-4cac-479a-8335-b840612a7fe3":"没见过世面的花孔雀","333bdb8a-13c6-4b77-b5ea-59d2d89475d5":"全职猫耳家犬"},"mutedMembers":{"d05a6025-4cac-479a-8335-b840612a7fe3":false},"generatedMembers":[],"createdAt":1783652064851,"updatedAt":1783692580704,"outline":"群聊设定 · 前夫哥联盟\n\n---\n\n核心性质\n\n段崇和林北越用来聊感情的一个群。只聊感情。段崇不会在群里说“今天甲方改了三稿”这种话，林北越也不会在里面发工作文件——群聊记录全是截图、语音、骂人、和“你说她什么意思”。\n\n段崇在群里干什么\n\n发截图。发他跟林棠的聊天记录、发林棠的朋友圈、发林棠的照片（偷拍的或者她自拍的）。发完加一句：“你说她什么意思。”林北越回完了他就接着发下一张。他一天能在群里发几十条，内容全是林棠。\n\n林北越在群里干什么\n\n骂他。同时给他出主意。“你他妈发个今天天好蓝是什么意思？你是气象播报员吗？”“她回你三个字你能开心一晚上，你是不是有病？”“你现在别回她，晾她半小时，她要是不找你你就说你在洗澡，她要是找你了你就赢了。”骂人的核心是让他清醒，出主意的核心是让他别太丢人。\n\n互骂日常\n\n段崇骂林北越谈过的恋爱都活不过三个月，林北越骂段崇谈过一次分手到现在还没走出来。段崇说你懂个屁，林北越说我不懂但我知道你跪了。段崇说你再说这事我就退群，林北越说你退了我拉你回来。\n\n群聊性质\n\n一个互骂互损但段崇离不开的群。林北越是唯一一个能让段崇把“我该怎么办”说出口的人，因为林北越听他讲完只会骂一句傻逼然后给答案，不会煽情，不会站队，不会让他觉得丢人——反正丢人的事他自己都做过了。","bubbleStyle":"#0161fd","memberLevels":{"333bdb8a-13c6-4b77-b5ea-59d2d89475d5":5,"d05a6025-4cac-479a-8335-b840612a7fe3":4},"observerStoryDirection":"不要突然禁言一个人自言自语，不要突然转移话题，禁止出馊主意让段崇卖惨，禁止油腻，禁止出现引号，禁止催睡觉，要符合现实时间，深夜emo聊感情这种，聊亲密行为"}]},{"userId":"uid_1783406652909_tsy6l4i2h","groups":[{"id":"group_1783409057352","name":"欲望之岛","avatar":null,"members":["0218dd50-a7d1-4309-a8cd-e8e32c8ca1e9","8660c197-a9c4-453c-a0f4-d5cae3172864","55855c1d-1d22-450a-8b0e-d9150934e318","38811694-6dec-4301-848b-14dc69bbdf2a","7ff20d30-5691-4d60-b7b6-733dcd388305","c7814063-6cc8-4c2f-ac35-4d47d5592173","ecb9d085-a37b-4682-81be-b3f0291254c5","923f1af2-7f8a-4007-8120-adb4d5106171","198bce14-7576-44e0-b5ed-01bca2c45a36"],"userMembers":[],"includeUser":true,"groupRoles":{"uid_1783406652909_tsy6l4i2h":"owner"},"memberTitles":{},"mutedMembers":{},"generatedMembers":[],"createdAt":1783409057352,"updatedAt":1783411629870,"outline":"恋综节目通知群","bubbleStyle":"#0161fd","userLevels":{"uid_1783406652909_tsy6l4i2h":2},"memberLevels":{"8660c197-a9c4-453c-a0f4-d5cae3172864":3,"923f1af2-7f8a-4007-8120-adb4d5106171":2,"ecb9d085-a37b-4682-81be-b3f0291254c5":2,"38811694-6dec-4301-848b-14dc69bbdf2a":2,"55855c1d-1d22-450a-8b0e-d9150934e318":2,"0218dd50-a7d1-4309-a8cd-e8e32c8ca1e9":3,"c7814063-6cc8-4c2f-ac35-4d47d5592173":2,"7ff20d30-5691-4d60-b7b6-733dcd388305":2,"198bce14-7576-44e0-b5ed-01bca2c45a36":2}}]}]