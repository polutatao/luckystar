racterId":"e005ad20-6483-4398-97f5-8088200867c3","_id":191636},{"id":1792385855827,"text":"真完蛋的是我，天天都像在排卵期对你上头","rawContent":"真完蛋的是我，天天都像在排卵期对你上头","isHtml":false,"sticker":null,"sender":"them","time":"14:37","timestamp":1792391827945,"roundId":"round_1792391808729_se26vucl7","generatedMode":false,"translation":null,"userId":"uid_1775896106705_evl3e13jn","characterId":"e005ad20-6483-4398-97f5-8088200867c3","_id":191637},{"id":1792385855828,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"14:37","timestamp":1792391830214,"roundId":"round_1792391808729_se26vucl7","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"吃了两块车上发的小饼干，还喝了温水，不饿。出门前急着抱你没顾上，等会儿到家我妈肯定备了一大桌菜，少吃点刚好留着肚子。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"whisper","translation":null,"userId":"uid_1775896106705_evl3e13jn","characterId":"e005ad20-6483-4398-97f5-8088200867c3","_id":191638},{"id":1792385855829,"text":"倒是你，阿姨送饭过去还要一会儿，厨房岛台上有我早上洗好的车厘子，先吃两颗垫着","rawContent":"倒是你，阿姨送饭过去还要一会儿，厨房岛台上有我早上洗好的车厘子，先吃两颗垫着","isHtml":false,"sticker":null,"sender":"them","time":"14:37","timestamp":1792391830220,"roundId":"round_1792391808729_se26vucl7","generatedMode":false,"translation":null,"userId":"uid_1775896106705_evl3e13jn","characterId":"e005ad20-6483-4398-97f5-8088200867c3","_id":191639},{"id":1792385855830,"text":"","rawContent":"","isHtml":false,"sticker":"https://i.postimg.cc/KYck9R1X/1778988322642.png","stickerMeaning":"蹭蹭","sender":"them","time":"14:37","timestamp":1792391831406,"roundId":"round_1792391808729_se26vucl7","generatedMode":false,"translation":null,"userId":"uid_1775896106705_evl3e13jn","characterId":"e005ad20-6483-4398-97f5-8088200867c3","_id":191640},{"id":1792385855831,"text":"陆驰抬手扶了扶衬衫衣领，目光柔和地落回手机界面。他垂着眼睫，修长的拇指在温热的机身侧面无意识摩挲，腕间的细红绳在冷白皮的衬托下格外显眼。想到几个小时后就要推开澜樾府的大门，他眼里没有退缩，只有一种经过岁月沉淀后的笃定与沉着。","rawContent":"陆驰抬手扶了扶衬衫衣领，目光柔和地落回手机界面。他垂着眼睫，修长的拇指在温热的机身侧面无意识摩挲，腕间的细红绳在冷白皮的衬托下格外显眼。想到几个小时后就要推开澜樾府的大门，他眼里没有退缩，只有一种经过岁月沉淀后的笃定与沉着。","isHtml":false,"