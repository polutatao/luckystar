07-8542-164c0e16cd9c","_id":150927,"vts":1788231602288},{"id":1787016030080,"text":"你看我这课讲得这么细致入微，全方位堵死漏洞。","rawContent":"你看我这课讲得这么细致入微，全方位堵死漏洞。","isHtml":false,"sticker":null,"sender":"them","time":"10:20","timestamp":1787019637885,"roundId":"round_1787019623347_5b0g560lo","generatedMode":false,"translation":null,"userId":"uid_1785086053730_xmmbr1tgn","characterId":"a891c8ab-1af2-4207-8542-164c0e16cd9c","_id":150928,"vts":1788231602500},{"id":1787016030081,"text":"是不是比你高中看那些悬疑小说有用多了？","rawContent":"是不是比你高中看那些悬疑小说有用多了？","isHtml":false,"sticker":null,"sender":"them","time":"10:20","timestamp":1787019637886,"roundId":"round_1787019623347_5b0g560lo","generatedMode":false,"translation":null,"userId":"uid_1785086053730_xmmbr1tgn","characterId":"a891c8ab-1af2-4207-8542-164c0e16cd9c","_id":150929,"vts":1788231602501},{"id":1787016030082,"text":"沈同学，是不是该给讲师一点正向反馈？","rawContent":"沈同学，是不是该给讲师一点正向反馈？","isHtml":false,"sticker":null,"sender":"them","time":"10:20","timestamp":1787019638185,"roundId":"round_1787019623347_5b0g560lo","generatedMode":false,"translation":null,"userId":"uid_1785086053730_xmmbr1tgn","characterId":"a891c8ab-1af2-4207-8542-164c0e16cd9c","_id":150930,"vts":1788231602800},{"id":1787016030083,"text":"沈清和看着他近在咫尺的那张俊脸，眼尾微微下垂带着点无辜又傲娇的神气，那副孔雀开屏的模样简直毫无掩饰。她嘴角微微动了动，小声说了一句「贺老师讲得挺生动的」。","rawContent":"沈清和看着他近在咫尺的那张俊脸，眼尾微微下垂带着点无辜又傲娇的神气，那副孔雀开屏的模样简直毫无掩饰。她嘴角微微动了动，小声说了一句「贺老师讲得挺生动的」。","isHtml":false,"sticker":null,"sender":"them","time":"10:20","timestamp":1787019638429,"roundId":"round_1787019623347_5b0g560lo","generatedMode":false,"type":"state","translation":null,"userId":"uid_1785086053730_xmmbr1tgn","characterId":"a891c8ab-1af2-4207-8542-164c0e16cd9c","_id":150931,"vts":1788231603044},{"id":1787016030084,"text":"贺寻听到这声称呼，眉梢挑得老高，喉咙里溢出一声满足的低哼。他顺势偏过头，温热的嘴唇擦过她的唇角，一路吻到她泛红的耳垂上，轻轻吮了一下，声音黏糊糊地散在两人的呼吸之间。","rawContent":"贺寻听到这声称呼，眉梢挑得老高，喉咙里溢出一声满足的低哼。他顺势偏过头，温热的嘴唇擦过她的唇角，一路吻到她泛红的耳垂上，轻轻吮了一下，声音黏糊糊地散在两人的呼吸之间。","isHtml":false,"sticker":null,"sender":"them","time":"10:20","timestamp":1787019638430,"roundId":"round_1787019623347_5b0g560lo","generatedMode":false,"type":"state","translation":null,"userId":"uid_1785086053730_xmmbr1tgn","characterId":"a891c8ab-1af2-4207-8542-164c0e16cd9c","_id":150932,"vts":1788231603045},{"id":1787016030085,"text":"光口头夸奖可不行。","rawContent":"光口头夸奖可不行。","isHtml":false,"sticker":null,"sender":"them","time":"10:20","timestamp":1787019638594,"roundId":"round_1787019623347_5b0g560lo","generatedMode":false,"translation":null,"userId":"uid_1785086053730_xmmbr1tgn","characterId":"a891c8ab-1af2-4207-8542-164c0e16cd9c","_id":150933,"vts":1788231603209},{"id":1787016030086,"text":"实践课也得跟上。","rawContent":"实践课也得跟上。","isHtml":false,"sticker":null,"sender":"them","time":"10:20","timestamp":1787019638660,"roundId":"round_1787019623347_5b0g560lo","generatedMode":false,"translation":null,"userId":"uid_1785086053730_xmmbr1tgn","characterId":"a891c8ab-1af2-4207-8542-164c0e16cd9c","_id":150934,"vts":1788231603275},{"id":1787016030087,"text":"再盖个章，这次要正中间的。","rawContent":"再盖个章，这次要正中间的。","isHtml":false,"sticker":null,"sender":"them","time":"10:20","timestamp":1787019639825,"roundId":"round_1787019623347_5b0g560lo","generatedMode":false,"translation":null,"userId":"uid_1785086053730_xmmbr1tgn","characterId":"a891c8ab-1af2-4207-8542-164c0e16cd9c","_id":150935,"vts":1788231604440},{"id":1787016030088,"text":"（user撅嘴）","sender":"me","type":"state","time":"10:21","timestamp":1787019679456,"replyTo":null,"userId":"uid_1785086053730_xmmbr1tgn","characterId":"a891c8ab-1af2-4207-8542-164c0e16cd9c","_id":150936,"vts":1788231644071},{"id":1787016030089,"text":"你教我","sender":"me","type":"state","time":"10:21","timestamp":1787019681670,"replyTo":null,"userId":"uid_1785086053730_xmmbr1tgn","characterId":"a891c8ab-1af2-4207-8542-164c0e16cd9c","_id":150937,"vts":1788231646285},{"id":1787016030091,"text":"贺寻看着她微微撅起的嘴唇，眼底的笑意一下子漾开，整个人像被顺了毛的大型犬一样软下来。他抬起右手，微凉的指尖很轻地碰了碰她的下巴尖。","rawContent":"贺寻看着她微微撅起的嘴唇，眼底的笑意一下子漾开，整个人像被顺了毛的大型犬一样软下来。他抬起右手，微凉的指尖很轻地碰了碰她的下巴尖。","isHtml":fa