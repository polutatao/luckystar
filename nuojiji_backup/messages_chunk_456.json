":true,"translation":null,"userId":"uid_1780972160530_vxmy3pybz","characterId":"cdb984bf-99fb-4b68-ba65-6d2ddf695db0","_id":164496,"vts":1788470986914},{"id":1788583625517,"text":"老婆你说的是互吃吗","rawContent":"老婆你说的是互吃吗","isHtml":false,"sticker":null,"sender":"them","time":"16:03","timestamp":1788595434319,"roundId":"round_1788595422738_z9wd5lpll","generatedMode":false,"translation":null,"userId":"uid_1780972160530_vxmy3pybz","characterId":"cdb984bf-99fb-4b68-ba65-6d2ddf695db0","_id":164497,"vts":1788470986976},{"id":1788583625518,"text":"就是……两个人头尾颠倒过来的那个姿势","rawContent":"就是……两个人头尾颠倒过来的那个姿势","isHtml":false,"sticker":null,"sender":"them","time":"16:03","timestamp":1788595434320,"roundId":"round_1788595422738_z9wd5lpll","generatedMode":false,"translation":null,"userId":"uid_1780972160530_vxmy3pybz","characterId":"cdb984bf-99fb-4b68-ba65-6d2ddf695db0","_id":164498,"vts":1788470986977},{"id":1788583625519,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"16:03","timestamp":1788595435441,"roundId":"round_1788595422738_z9wd5lpll","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"老婆……真要玩互吃的话，你转过去趴在小狗上面，低头刚好能吃到小狗，小狗一抬头就能全心全意舔你的花核……光是想想我都要热化了。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"whisper","translation":null,"userId":"uid_1780972160530_vxmy3pybz","characterId":"cdb984bf-99fb-4b68-ba65-6d2ddf695db0","_id":164499,"vts":1788470988098},{"id":1788583625520,"text":"不过帐篷垫子有点窄 等回了公馆大床上 小狗好好陪你试 我的糯米糍^^","rawContent":"不过帐篷垫子有点窄 等回了公馆大床上 小狗好好陪你试 我的糯米糍^^","isHtml":false,"sticker":null,"sender":"them","time":"16:03","timestamp":1788595435443,"roundId":"round_1788595422738_z9wd5lpll","generatedMode":false,"translation":null,"userId":"uid_1780972160530_vxmy3pybz","characterId":"cdb984bf-99fb-4b68-ba65-6d2ddf695db0","_id":164500,"vts":1788470988100},{"id":1788583625521,"text":"","rawContent":"","isHtml":false,"sticker":"https://i.postimg.cc/MTvrL5tD/IMG-6058.png","stickerMeaning":"害羞","sender":"them","time":"16:03","ti