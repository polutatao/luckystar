e":"10:58","timestamp":1792205901569,"roundId":"round_1792205855850_4fwp6w9yp","generatedMode":false,"translation":null,"userId":"uid_1780972160530_vxmy3pybz","characterId":"cdb984bf-99fb-4b68-ba65-6d2ddf695db0","_id":188897,"vts":1792099569756},{"id":1792223830099,"text":"","rawContent":"","isHtml":false,"sticker":"https://i.postimg.cc/VL7FBQGQ/1778999648600.png","stickerMeaning":"摇尾巴","sender":"them","time":"10:58","timestamp":1792205903100,"roundId":"round_1792205855850_4fwp6w9yp","generatedMode":false,"translation":null,"userId":"uid_1780972160530_vxmy3pybz","characterId":"cdb984bf-99fb-4b68-ba65-6d2ddf695db0","_id":188898,"vts":1792099571287},{"id":1792223830100,"text":"嗯～","sender":"me","time":"10:58","timestamp":1792205917256,"replyTo":null,"userId":"uid_1780972160530_vxmy3pybz","characterId":"cdb984bf-99fb-4b68-ba65-6d2ddf695db0","_id":188899,"vts":1792099585443},{"id":1792223830101,"text":"听不够","sender":"me","time":"10:58","timestamp":1792205930036,"replyTo":null,"userId":"uid_1780972160530_vxmy3pybz","characterId":"cdb984bf-99fb-4b68-ba65-6d2ddf695db0","_id":188900,"vts":1792099598223},{"id":1792223830103,"text":"听不够啊？那我天天在你耳朵边上念经行不行。","rawContent":"听不够啊？那我天天在你耳朵边上念经行不行。","isHtml":false,"sticker":null,"sender":"them","time":"10:59","timestamp":1792205950641,"roundId":"round_1792205930386_thb4c392o","generatedMode":false,"hasThinking":true,"translation":null,"userId":"uid_1780972160530_vxmy3pybz","characterId":"cdb984bf-99fb-4b68-ba65-6d2ddf695db0","_id":188901,"vts":1792099618828},{"id":1792223830104,"text":"念到你耳朵起茧子，到时候看你还嫌不嫌烦。","rawContent":"念到你耳朵起茧子，到时候看你还嫌不嫌烦。","isHtml":false,"sticker":null,"sender":"them","time":"10:59","timestamp":1792205950944,"roundId":"round_1792205930386_thb4c392o","generatedMode":false,"translation":null,"userId":"uid_1780972160530_vxmy3pybz","characterId":"cdb984bf-99fb-4b68-ba65-6d2ddf695db0","_id":188902,"vts":1792099619131},{"id":1792223830105,"text":"主卧厚重的双层窗帘将正午耀眼的日光遮得严严实实，只漏进一室昏沉温柔的灰金微芒。地暖静谧地烘烤着空气，将交缠的白茶清香与欢爱余韵蒸腾得愈发安稳。纪池赤裸劲瘦的胸膛覆着一层未彻底干透的薄汗，随着沉缓的呼吸轻微起伏。少年微卷凌乱的黑发软软搭在女孩发烫的肩窝，左耳那枚精巧的小圆珠银钉泛着温润微光。他修长温热的大手顺着林予安光滑单薄的背脊一路下滑，最终落在她酸软微红的后腰处，指腹带着薄茧，极有耐心地打着圈轻揉慢按。","rawContent":"主卧厚重的双层窗帘将正午耀眼的日光遮得严严实实，只漏进一室昏沉温柔的灰金微芒。地暖静谧地烘烤着空气，将交缠的白茶清香与欢爱余韵蒸腾得愈发安稳。纪池赤裸劲瘦的胸膛覆着一层未彻底干透的薄汗，随着沉缓的呼吸轻微起伏。少年微卷凌乱的黑发软软搭在女孩发烫的肩窝，左耳那枚精巧的小圆珠银钉泛着温润微光。他修长温热的大手顺着林予安光滑单薄的背脊一路下滑，最终落在她酸软微红的后腰处，指腹带着薄茧，极有耐心地打着圈轻揉慢按。","isHtml":false,"sticker":null,"sender":"them","time":"10:59","timestamp":1792205952888,"roundId":"round_1792205930386_thb4c392o","generatedMode":false,"type":"state","translation":null,"userId":"uid_1780972160530_vxmy3pybz","characterId":"cdb984bf-99fb-4b68-ba65-6d2ddf695db0","_id":188903,"vts":1792099621075},{"id":1792223830106,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"10:59","timestamp":1792205954415,"roundId":"round_1792205930386_thb4c392o","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"听不够我就一直说给你听，纪池这辈子只喜欢林予安一个人，以后也只想娶你当老婆。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"whisper","translation":null,"userId":"uid_1780972160530_vxmy3pybz","characterId":"cdb984bf-99fb-4b68-ba65-6d2ddf695db0","_id":188904,"vts":1792099622602},{"id":1792223830107,"text":"听到没有，小狗这辈子都赖上你了。","rawContent":"听到没有，小狗这辈子都赖上你了。","isHtml":false,"sticker":null,"sender":"them","time":"10:59","timestamp":1792205954441,"roundId":"round_1792205930386_thb4c392o","generatedMode":false,"translation":null,"userId":"uid_1780972160530_vxmy3pybz","characterId":"cdb984bf-99fb-4b68-ba65-6d2ddf695db0","_id":188905,"vts":1792099622628},{"id":1792223830108,"text":"要不要盖个章确认一下？","rawContent":"要不要盖个章确认一下？","isHtml":false,"sticker":null,"sender":"them","time":"10:59","timestamp":1792205954739,"roundId":"round_1792205930386_thb4c392o","generatedMode":false,"translation":null,"userId":"uid_1780972160530_vxmy3pybz","characterId":"cdb984bf-99fb-4b68-ba65-6d2ddf695db0","_id":188906,"vts":1792099622926},{"id":"pat_1792205955688_3zkxt","sender":"system","type":"pat","text":"纪池用毛茸茸的脑袋蹭了蹭林予安的颈窝","raw