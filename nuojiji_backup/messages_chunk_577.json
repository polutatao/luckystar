82369305,"text":"下午带你去划船看水。","rawContent":"下午带你去划船看水。","isHtml":false,"sticker":null,"sender":"them","time":"08:41","timestamp":1792284087560,"roundId":"round_1792284023220_bwfscd9rv","generatedMode":false,"translation":null,"userId":"uid_1785086053730_xmmbr1tgn","characterId":"a891c8ab-1af2-4207-8542-164c0e16cd9c","_id":189375},{"id":1792282369306,"text":"嗯嗯，好吃","sender":"me","time":"08:41","timestamp":1792284097014,"replyTo":null,"userId":"uid_1785086053730_xmmbr1tgn","characterId":"a891c8ab-1af2-4207-8542-164c0e16cd9c","_id":189376},{"id":1792282369307,"text":"（吃完）","sender":"me","time":"08:41","timestamp":1792284102056,"replyTo":null,"rawContent":"[STATE]（吃完）","isHtml":false,"type":"state","userId":"uid_1785086053730_xmmbr1tgn","characterId":"a891c8ab-1af2-4207-8542-164c0e16cd9c","_id":189377},{"id":1792282369308,"text":"我还不想起来……","sender":"me","time":"08:41","timestamp":1792284107213,"replyTo":null,"userId":"uid_1785086053730_xmmbr1tgn","characterId":"a891c8ab-1af2-4207-8542-164c0e16cd9c","_id":189378},{"id":1792291374203,"text":"不想起就不起呗","rawContent":"不想起就不起呗","isHtml":false,"sticker":null,"sender":"them","time":"08:49","timestamp":1792284545657,"roundId":"round_1792284478337_yaali51h4","generatedMode":false,"hasThinking":true,"translation":null,"userId":"uid_1785086053730_xmmbr1tgn","characterId":"a891c8ab-1af2-4207-8542-164c0e16cd9c","_id":189379},{"id":1792291374204,"text":"今天周日本来就该赖床","rawContent":"今天周日本来就该赖床","isHtml":false,"sticker":null,"sender":"them","time":"08:49","timestamp":1792284545662,"roundId":"round_1792284478337_yaali51h4","generatedMode":false,"translation":null,"userId":"uid_1785086053730_xmmbr1tgn","characterId":"a891c8ab-1af2-4207-8542-164c0e16cd9c","_id":189380},{"id":1792291374205,"text":"白瓷餐盘里只剩下一圈浅淡的蛋黄痕迹，叉子搁在盘沿发出清脆的轻碰声。贺寻探手接过空盘子反手放到床头柜最外侧，顺势踢掉脚上的深蓝色室内拖鞋，掀开深灰色的被角便一头扎进了被窝里。床垫随着他修长结实的身躯陷下去一小块，他长臂一伸，极其自然地穿过沈清和纤细的腰后，把人严严实实地往自己温热的胸膛前带了带。","rawContent":"白瓷餐盘里只剩下一圈浅淡的蛋黄痕迹，叉子搁在盘沿发出清脆的轻碰声。贺寻探手接过空盘子反手放到床头柜最外侧，顺势踢掉脚上的深蓝色室内拖鞋，掀开深灰色的被角便一头扎进了被窝里。床垫随着他修长结实的身躯陷下去一小块，他长臂一伸，极其自然地穿过沈清和纤细的腰后，把人严严实实地往自己温热的胸膛前带了带。","isHtml":false,"sticker":null,"sender":"them","time":"08:49","timestamp":1792284547017,"roundId":"round_1792284478337_yaali51h4","generatedMode":false,"type":"state","translation":null,"userId":"uid_1785086053730_xmmbr1tgn","characterId":"a891c8ab-1af2-4207-8542-164c0e16cd9c","_id":189381},{"id":1792291374206,"text":"盘子我顺手搁床头了","rawContent":"盘子我顺手搁床头了","isHtml":false,"sticker":null,"sender":"them","time":"08:49","timestamp":1792284547018,"roundId":"round_1792284478337_yaali51h4","generatedMode":false,"translation":null,"userId":"uid_1785086053730_xmmbr1tgn","characterId":"a891c8ab-1af2-4207-8542-164c0e16cd9c","_id":189382},{"id":1792291374207,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"08:49","timestamp":1792284549043,"roundId":"round_1792284478337_yaali51h4","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"阿和，那我可要钻进被窝陪你一块儿赖床了，再让我抱会儿。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"happy","translation":null,"userId":"uid_1785086053730_xmmbr1tgn","characterId":"a891c8ab-1af2-4207-8542-164c0e16cd9c","_id":189383},{"id":1792291374208,"text":"被窝里还是宝宝身上最香","rawContent":"被窝里还是宝宝身上最香","isHtml":false,"sticker":null,"sender":"them","time":"08:49","timestamp":1792284549047,"roundId":"round_1792284478337_yaali51h4","generatedMode":false,"translation":null,"userId":"uid_1785086053730_xmmbr1tgn","characterId":"a891c8ab-1af2-4207-8542-164c0e16cd9c","_id":189384},{"id":1792291374209,"text":"被子底下笼着满满当当的暖意，沈清和身上那股淡淡的书页墨香混着刚喝完的温牛奶甜味，丝丝缕缕往鼻尖里钻。贺寻把下巴搁在她柔软的肩窝处，闭着眼像只大型犬似的用脸颊轻轻蹭了蹭她温热的颈侧皮肤，修长的手指在被窝深处摸索着捉住她戴着翡翠细镯的左手，十指慢吞吞地扣紧，连呼吸都跟着变得绵长而黏糊。","rawContent":"被子底下笼着满满当当的暖意，沈清和身上那股淡淡的书页墨香混着刚喝完的温牛奶甜味，丝丝缕缕往鼻尖里钻。贺寻把下巴搁在她柔软的肩窝处，闭着眼像只大型犬似的用脸颊轻轻蹭了蹭她温热的颈侧皮肤，修长的手指在被窝深处摸索着捉住她戴着翡翠细镯的左手，十指慢吞吞地扣紧，连呼吸都跟着变得绵长而黏糊。","isHtml":false,"sticker":null,"sender":"them","time":"08:49","timestamp":1792284549419,"roundId":"round_1792284478337_yaali51h4","generatedMode":false,"type":"state",