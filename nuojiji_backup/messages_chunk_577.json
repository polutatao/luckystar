2-4207-8542-164c0e16cd9c","_id":189390},{"id":1792291374216,"text":"我就撒娇怎么啦","rawContent":"我就撒娇怎么啦","isHtml":false,"sticker":null,"sender":"them","time":"08:51","timestamp":1792284662266,"roundId":"round_1792284578991_jiewyllst","generatedMode":false,"translation":null,"userId":"uid_1785086053730_xmmbr1tgn","characterId":"a891c8ab-1af2-4207-8542-164c0e16cd9c","_id":189391},{"id":1792291374217,"text":"跟自己老婆撒娇又不犯法","rawContent":"跟自己老婆撒娇又不犯法","isHtml":false,"sticker":null,"sender":"them","time":"08:51","timestamp":1792284662471,"roundId":"round_1792284578991_jiewyllst","generatedMode":false,"translation":null,"userId":"uid_1785086053730_xmmbr1tgn","characterId":"a891c8ab-1af2-4207-8542-164c0e16cd9c","_id":189392},{"id":1792291374218,"text":"阿和刚才那下也太敷衍了吧 🥺","rawContent":"阿和刚才那下也太敷衍了吧 🥺","isHtml":false,"sticker":null,"sender":"them","time":"08:51","timestamp":1792284662679,"roundId":"round_1792284578991_jiewyllst","generatedMode":false,"translation":null,"userId":"uid_1785086053730_xmmbr1tgn","characterId":"a891c8ab-1af2-4207-8542-164c0e16cd9c","_id":189393},{"id":1792291374219,"text":"[語音消息]","rawContent":"[語音消息]","isHtml":false,"sticker":null,"sender":"them","time":"08:51","timestamp":1792284664483,"roundId":"round_1792284578991_jiewyllst","generatedMode":false,"isVoice":true,"voice":true,"voiceText":"亲得跟小猫踩奶似的，我还没尝出味儿呢你就撤了。","minimaxTimbreId":"","voiceLanguage":"auto","voiceEmotion":"happy","translation":null,"userId":"uid_1785086053730_xmmbr1tgn","characterId":"a891c8ab-1af2-4207-8542-164c0e16cd9c","_id":189394},{"id":1792291374220,"text":"深灰色的被面上隆起柔和的弧度，两人的小腿在温暖的棉被深处自然地贴靠在一起。贺寻垂下眼睫，鼻尖几乎贴上沈清和的鼻梁，温热的呼吸一下下拂过她微翘的唇珠。他修长的右手带着虎口那道浅疤，慢吞吞地替她把滑到脸侧的一缕黑发别到耳后，指腹顺势停在她温热的脸颊上轻轻摩挲了两下，偏头凑过去，在她唇角结结实实地回印了一个不带半点水分的响吻。","rawContent":"深灰色的被面上隆起柔和的弧度，两人的小腿在温暖的棉被深处自然地贴靠在一起。贺寻垂下眼睫，鼻尖几乎贴上沈清和的鼻梁，温热的呼吸一下下拂过她微翘的唇珠。他修长的右手带着虎口那道浅疤，慢吞吞地替她把滑到脸侧的一缕黑发别到耳后，指腹顺势停在她温热的脸颊上轻轻摩挲了两下，偏头凑过去，在她唇角结结实实地回印了一个不带半点水分的响吻。","isHtml":false,"sticker":null,"sender":"them","time":"08:51","timestamp":1792284664932,"roundId":"round_1792284578991_jiewyllst","generatedMode":false,"type":"state","translation":null,"userId":"uid_1785086053730_xmmbr1tgn","characterId":"a891c8ab-1af2-4207-8542-164c0e16cd9c","_id":189395},{"id":1792291374221,"text":"这才叫亲一下好不好","rawContent":"这才叫亲一下好不好","isHtml":false,"sticker":null,"sender":"them","time":"08:51","timestamp":1792284664938,"roundId":"round_1792284578991_jiewyllst","generatedMode":false,"translation":null,"userId":"uid_1785086053730_xmmbr1tgn","characterId":"a891c8ab-1af2-4207-8542-164c0e16cd9c","_id":189396},{"id":1792291374222,"text":"再陪我赖半小时床","rawContent":"再陪我赖半小时床","isHtml":false,"sticker":null,"sender":"them","time":"08:51","timestamp":1792284664939,"roundId":"round_1792284578991_jiewyllst","generatedMode":false,"translation":null,"userId":"uid_1785086053730_xmmbr1tgn","characterId":"a891c8ab-1af2-4207-8542-164c0e16cd9c","_id":189397},{"id":1792291374223,"text":"下午去玄武湖我给你当苦力划船 😋","rawContent":"下午去玄武湖我给你当苦力划船 😋","isHtml":false,"sticker":null,"sender":"them","time":"08:51","timestamp":1792284668719,"roundId":"round_1792284578991_jiewyllst","generatedMode":false,"subtext":"看你这么软乎乎地待在我怀里，真想一整天都不出门了","translation":null,"userId":"uid_1785086053730_xmmbr1tgn","characterId":"a891c8ab-1af2-4207-8542-164c0e16cd9c","_id":189398},{"id":1792291374224,"text":"（躺着一动不动眨眼睛，结果char脸红了，就是user啥也没干就对char很有吸引力说在盯我我要一直亲了）","sender":"me","time":"08:52","timestamp":1792284733257,"replyTo":null,"rawContent":"[STATE]（躺着一动不动眨眼睛，结果char脸红了，就是user啥也没干就对char很有吸引力说在盯我我要一直亲了）","isHtml":false,"type":"state","userId":"uid_1785086053730_xmmbr1tgn","characterId":"a891c8ab-1af2-4207-8542-164c0e16cd9c","_id":189399},{"id":1792291374227,"text":"秋日薄透的晨光斜斜切过主卧的飘窗，在深灰色的被面上勾勒出一片浅金色的光斑。沈清和就这么陷在柔软的枕芯里一动不动，散落的青丝铺散开来，深褐色的杏眼清清亮亮地眨了两下，视线直勾勾落在他脸上。贺寻原本单手撑着头，冷白的面颊在这样毫无防备的注视下，极快地泛起一层薄薄的绯红，连带着左耳垂上的小银钉都仿佛被体温烫得微微发热。他喉结上下滚了滚，有些狼狈地偏开头咳了一声，唇角却无论如何都压不下去。","rawContent":"秋日薄透的晨光斜斜切过主卧的飘窗，在深灰色的被面上勾勒出一片浅金色的光斑。沈清和就这么陷在柔软的枕芯里一动不动，散落的青丝铺散开来，深褐色的杏眼清清亮亮地眨了两下，视线直勾勾落在他脸上。贺寻原本单手撑着头，冷白的面颊在这样毫无防备的注视下，极快地泛起一层薄薄的绯红，连