578},{"id":1792546260433,"text":"八点半推开门，我先洗沙发垫，洗完正好吃甜点，时间刚刚好。","rawContent":"八点半推开门，我先洗沙发垫，洗完正好吃甜点，时间刚刚好。","isHtml":false,"sticker":null,"sender":"them","time":"09:48","timestamp":1792547330756,"roundId":"round_1792547314222_rgshnpa3i","generatedMode":false,"translation":null,"userId":"uid_1775896106705_evl3e13jn","characterId":"e005ad20-6483-4398-97f5-8088200867c3","_id":194579},{"id":1792546260434,"text":"","rawContent":"","isHtml":false,"sticker":"https://i.postimg.cc/G37pf9W7/Image-1780405926206-331.jpg","stickerMeaning":"使坏","sender":"them","time":"09:48","timestamp":1792547331598,"roundId":"round_1792547314222_rgshnpa3i","generatedMode":false,"translation":null,"userId":"uid_1775896106705_evl3e13jn","characterId":"e005ad20-6483-4398-97f5-8088200867c3","_id":194580},{"id":1792546260435,"text":"……?","sender":"me","time":"09:49","timestamp":1792547358710,"replyTo":null,"userId":"uid_1775896106705_evl3e13jn","characterId":"e005ad20-6483-4398-97f5-8088200867c3","_id":194581},{"id":1792546260436,"text":"合着不吃饭是来吃我的呀","sender":"me","time":"09:49","timestamp":1792547367863,"replyTo":null,"userId":"uid_1775896106705_evl3e13jn","characterId":"e005ad20-6483-4398-97f5-8088200867c3","_id":194582},{"id":1792546260495,"text":"那不然呢？","rawContent":"那不然呢？","isHtml":false,"sticker":null,"sender":"them","time":"09:49","timestamp":1792547385829,"roundId":"round_1792547368262_wrajkchyv","generatedMode":false,"translation":null,"userId":"uid_1775896106705_evl3e13jn","characterId":"e005ad20-6483-4398-97f5-8088200867c3","_id":194640},{"id":1792546260496,"text":"沈老师才反应过来啊","rawContent":"沈老师才反应过来啊","isHtml":false,"sticker":null,"sender":"them","time":"09:49","timestamp":1792547385833,"roundId":"round_1792547368262_wrajkchyv","generatedMode":false,"translation":null,"userId":"uid_1775896106705_evl3e13jn","characterId":"e005ad20-6483-4398-97f5-8088200867c3","_id":194641},{"id":1792546260497,"text":"在家里被我妈拉着说了两个小时，嘴都快说干了，心里全是某人","rawContent":"在家里被我妈拉着说了两个小时，嘴都快说干了，心里全是某人","isHtml":false,"st